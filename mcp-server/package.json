{
  "name": "mcflow-server",
  "version": "0.1.0-dev.0",
  "description": "MCP server for mcflow: control a local Paper test server, test bots and a real Minecraft client",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcflow-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "mineflayer": "4.39.0",
    "smol-toml": "1.9.1",
    "vec3": "0.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LadonON/mcflow.git",
    "directory": "mcp-server"
  }
}
